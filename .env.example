# Copy to .env (never commit .env)
ANTHROPIC_API_KEY=
# For provider = "openai" in config/agent.toml (OpenAI, OpenRouter, Ollama...):
OPENAI_API_KEY=

# Telegram bot (python -m agent telegram)
TELEGRAM_BOT_TOKEN=
# Numeric chat ids allowed to use the bot, comma separated. Leave empty first, message the bot, and it will tell you your id.
TELEGRAM_ALLOWED_IDS=

# Email the generated files (optional). Gmail: turn on 2-step verification, then create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional: default recipients offered in the menu, comma separated (for example your own address)
EMAIL_TO=
# Optional: sender address (defaults to SMTP_USER)
EMAIL_FROM=

# Optional settings
# Where knowledge/, memory/, output/, logs/ and the search index live (a mounted volume in a container)
AGENT_DATA_DIR=
# Set to "native" if your terminal already handles right-to-left text
AGENT_TERMINAL_BIDI=
# CPU threads for embedding (default: half the cores)
RAG_THREADS=
